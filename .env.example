# Elma ASPM — exemplo de configuração de ambiente.
# Copie para `.env` (ignorado pelo Git) e preencha os valores reais.
# Nunca versione credenciais; em CI, use o gerenciador de secrets
# (ex.: secrets.ELMA_API_KEY no GitHub Actions, como em scan.yml).

# --- Banco de dados ---
# Caminho do SQLite usado por CLI e API (padrão: elma_findings.db).
ELMA_DB_PATH=elma_findings.db

# --- API HTTP ---
# Bearer token exigido em POST /findings (sem padrão: a API responde 500 se ausente).
ELMA_API_KEY=
# URL pública da API; fallback para links de ticket quando ELMA_DASHBOARD_URL não está definida.
ELMA_API_URL=http://localhost:8000

# --- IA (suggest-ia / remediar-ia / report --advice) ---
# Provedor: "gemini" (padrão) ou "ollama".
ELMA_LLM_PROVIDER=gemini
# Credencial Gemini; quando definida, também alimenta GOOGLE_API_KEY (setdefault).
ELMA_GOOGLE_API_KEY=
# Modelo do provedor em nuvem (padrão: gemini-2.5-flash).
ELMA_CLOUD_MODEL=gemini-2.5-flash
# Ollama local (padrões: llama3.1 em http://localhost:11434).
ELMA_OLLAMA_MODEL=llama3.1
ELMA_OLLAMA_BASE_URL=http://localhost:11434

# --- SLA (dias por severidade; vazio ou ausente = sem SLA) ---
# Padrões: CRITICAL=15, HIGH=30, MEDIUM=90, LOW=120; INFO/UNKNOWN não têm SLA.
# Valores precisam ser inteiros >= 0; configuração inválida falha cedo na subida.
#ELMA_SLA_CRITICAL=15
#ELMA_SLA_HIGH=30
#ELMA_SLA_MEDIUM=90
#ELMA_SLA_LOW=120
#ELMA_SLA_INFO=
#ELMA_SLA_UNKNOWN=

# --- Tickets GitHub ---
# Criação de issues na confirmação manual de findings CRITICAL.
# Desligado por padrão; ativar de verdade exige ELMA_TICKETS_ATIVO=true
# e ELMA_TICKETS_DRY_RUN=false. O token precisa de permissão de escrita
# de issues apenas nos repositórios necessários.
ELMA_TICKETS_ATIVO=false
ELMA_TICKETS_DRY_RUN=true
ELMA_GITHUB_TOKEN=
# Base dos links no corpo da issue (padrão: ELMA_API_URL ou http://localhost:8000).
ELMA_DASHBOARD_URL=http://localhost:8000
